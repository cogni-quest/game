{
  "name": "cogni-game",
  "private": true,
  "type": "module",
  "description": "A learning game for one child: maths first, then reading, logic, memory and attention",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "packages/tasks/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cogni/play --",
    "build": "npm run typecheck && npm run build --workspace @cogni/play",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
